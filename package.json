{
  "name": "mayo",
  "version": "1.0.3",
  "description": "",
  "keywords": [
    "memo"
  ],
  "homepage": "https://github.com/Manju2367/mayo#readme",
  "bugs": {
    "url": "https://github.com/Manju2367/mayo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manju2367/mayo.git"
  },
  "license": "ISC",
  "author": "koshianmanju",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "start:update-preview": "electron . --preview-updates",
    "build": "npx vite build && npx tsc -p tsconfig.electron.json",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "release:win": "npm run build && electron-builder --win nsis --publish onTag"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "jp.outlook.neco2367.mayo",
    "productName": "Mayo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "Manju2367",
      "repo": "mayo"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "vue": "^3.5.44"
  }
}
